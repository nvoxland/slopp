{:paths ["src"]

 ;; slopp-the-tool's deps: what the boot kernel needs to launch the store's
 ;; program. Project code declares ITS deps in the store manifest (deps_add);
 ;; build!/git_push generate a project deps.edn from it.
 :deps {org.clojure/clojure     {:mvn/version "1.12.5"}
        rewrite-clj/rewrite-clj {:mvn/version "1.1.48"}
        clj-kondo/clj-kondo     {:mvn/version "2024.11.14"}
        nrepl/nrepl             {:mvn/version "1.3.1"}
        cheshire/cheshire       {:mvn/version "5.13.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.955"}
        org.xerial/sqlite-jdbc  {:mvn/version "3.47.1.0"}
        org.eclipse.jgit/org.eclipse.jgit {:mvn/version "7.3.0.202506031305-r"}
        org.slf4j/slf4j-nop     {:mvn/version "2.0.16"}
        ;; D-web / D-web-cljs: these mirror the store manifest because they are
        ;; required by STORE CODE THE BOOT KERNEL MUST LOAD. The kernel loads
        ;; every :jvm and :cljc namespace of the store (only :cljs is skipped),
        ;; so a lib any of them requires has to be on the kernel classpath —
        ;; add-manifest-libs! cannot be relied on here (add-libs needs
        ;; tools.deps, which the uberjar does not carry).
        ;;   http-kit -> slopp.web.server.httpkit
        ;;   hiccup   -> slopp.web.html
        ;;   garden   -> slopp.web.css
        ;; Every entry here must be required by a PRODUCTION namespace. A
        ;; test-only lib no longer belongs: `boot-loads?` skips `-test`
        ;; namespaces, because this JVM never runs one. malli sat here for
        ;; exactly that reason and was justified by a comment naming namespaces
        ;; that had been deleted — twice, three weeks apart. Removing it took
        ;; 336 KB across 8 jars out of the uberjar (malli, core.rrb-vector,
        ;; tools.reader, test.check, edamame, fipp, dynaload, arrangement);
        ;; the image got malli from `image.repl/inherent-deps` and the external
        ;; test tier from the store manifest, which were the two places that
        ;; actually ran code needing it.
        ;;
        ;; malli is BACK (2026-08-15), and the earlier removal was right at the
        ;; time — the premise changed rather than the reasoning being wrong.
        ;; `slopp.cli.spec` declares command arguments in malli and SHIPS: it is
        ;; in the vendored framework, so a consuming project gets the source and
        ;; must be able to resolve what it requires. Two things follow, and both
        ;; are the point rather than side effects:
        ;;   - `build.clj`'s framework-deps derivation resolves a require by
        ;;     asking THIS basis which jar provides it, so a lib absent here is
        ;;     a lib a built app is never told about. It now REFUSES rather than
        ;;     skipping, which is what turns "silently missing" into this entry.
        ;;   - the version a consumer is handed is this one, so the framework
        ;;     and the app it lands in cannot disagree about malli.
        ;; The 336 KB is the cost of shipping a capability that validates.
        metosin/malli           {:mvn/version "0.20.1"}
        http-kit/http-kit       {:mvn/version "2.8.0"}
        hiccup/hiccup           {:mvn/version "2.0.0"}
        garden/garden           {:mvn/version "1.3.10"}}

 ;; No :test alias: the working tree is FILELESS (the store is the source).
 ;; The suite runs via test_run {external true} — build! to a temp dir whose
 ;; generated deps.edn carries its own runnable :test alias.
 :aliases
 {:nrepl {:main-opts ["-m" "nrepl.cmdline"]}

  ;; the release artifact: java -jar slopp.jar -m slopp.kernel.boot <dir> [...]
  ;; (main = clojure.main; slopp's code stays runtime-loaded — no AOT)
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build
          :paths ["."]}}}
