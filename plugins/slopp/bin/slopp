#!/bin/bash
# slopp CLI — the same release jar the MCP server runs, for direct use:
#   slopp <op> [json|edn|@file]                one tool call, routed to the running daemon
#   slopp --call <op> [json|edn|@file]         the same call, the long-standing spelling
#   slopp --main slopp.sync/-main import .     build the store from the repo's slopp branch
#   slopp --main slopp.sync/-main test .       isolated suite from a store build
#   slopp --doctor                             self-check the plugin wiring end-to-end
#   slopp daemon [port] | stop | status        ONE slopp for the machine: MCP over HTTP for every project
# `slopp daemon` is yours to start and stop; nothing else here starts one.
# It fetches and caches the versioned jar on first run; java 21+ required.
set -euo pipefail

VERSION="v0.3.0"
SHA256="3b958938c8eb2d6fcb61f721aea79b2cb66336cb8641d0cfc119b19a7a712d64"
JAR_URL="https://github.com/nvoxland/slopp/releases/download/${VERSION}/slopp.jar"

CACHE="${CLAUDE_PLUGIN_DATA:-${XDG_CACHE_HOME:-$HOME/.cache}/slopp}"
JAR="$CACHE/slopp-${VERSION}.jar"

if ! command -v java >/dev/null 2>&1; then
  echo "slopp: no 'java' on PATH — install a JDK (Temurin 21+ recommended)" >&2
  exit 1
fi

# --help never reaches the JVM: an unrecognized flag used to fall through
# to SERVE MODE, and a stray server launched that way once clobbered the
# routed fast path's address file with its own pid (measured, s13).
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  echo "  slopp <op> '{...json...}'                  bare tool call (routed to the running server)"
  echo "  slopp add <ns> [--prompt P] <<'EOF'        whole-blob write; forms split, add/replace inferred"
  echo "  slopp replace <ns/name> [--prompt P] <<'EOF'"
  echo "  slopp change [--prompt P] [--accept a,b] <<'EOF'   with ;;;tests <ns> / ;;;impl <ns> sections"
  echo "  slopp help '{\"topic\":\"<op>\"}'              one op's full card (args, examples)"
  exit 0
fi

. "$(cd "$(dirname "$0")" && pwd)/slopp-daemon-file"

# ---- CLI dialect: normalize every spelling to (TOOL, args-file) ----
#   slopp --call <op> [json|edn|@file]      the long-standing spelling
#   slopp <op> [json]                       same thing, bare
#   slopp add <ns> [--prompt P] <<EOF       whole-blob write: forms split and
#   slopp replace <ns/name> [--prompt P]    add/replace is inferred per form
#   slopp change [--prompt P] [--accept a,b] <<EOF
#       with ";;;tests <ns>" / ";;;impl <ns>" section markers between raw forms
# The heredoc carries RAW source — no JSON escaping, which is the point.
TOOL=""; ARGSFILE=""
case "${1:-}" in
  daemon)
    # `slopp daemon stop` / `status`: the daemon records itself in
    # ~/.slopp/daemon.json; stop sends SIGTERM to that pid and clears the
    # file, status prints /api/status. Everything else is a start.
    if [ "${2:-}" = "stop" ] || [ "${2:-}" = "status" ]; then
      daemon_file
      if [ ! -f "$DAEMON_FILE" ]; then echo "slopp daemon: none recorded (no $DAEMON_FILE)"; exit 1; fi
      read_daemon_file
      if kill -0 "$DPID" 2>/dev/null; then alive=1; else alive=0; fi
      if [ "$2" = "status" ]; then
        if body="$(curl -sS -m 3 "$DURL/status" 2>&1)"; then
          echo "pid $DPID: $body"; exit 0
        fi
        echo "slopp daemon: pid $DPID $([ "$alive" = 1 ] && echo alive || echo dead), $DURL not answering ($body)"; exit 1
      fi
      if [ "$alive" = 1 ]; then
        kill "$DPID" 2>/dev/null || true
        for _ in $(seq 1 50); do kill -0 "$DPID" 2>/dev/null || break; sleep 0.2; done
        echo "slopp daemon: stopped pid $DPID"
      else
        echo "slopp daemon: pid $DPID was already gone"
      fi
      rm -f "$DAEMON_FILE"
      exit 0
    fi
    # The daemon boots slopp's OWN code from the dir it is given — the
    # kernel loads every namespace of that dir's store into the JVM — so it
    # is launched from a NEUTRAL dir (~/.slopp, no store), never a project:
    # the projects it serves are whatever attaches. Working ON slopp needs
    # none of this: the machine daemon is a release and slopp's checkout is
    # a project like any other, whose dev instance (its run.daemon entry)
    # is the in-progress version. SLOPP_LIVE=1 with SLOPP_DAEMON_DIR=$PWD
    # is the older self-host loop, still honoured.
    DIR="${SLOPP_DAEMON_DIR:-$HOME/.slopp}"
    mkdir -p "$DIR"
    shift
    # the port is passed explicitly: with no --main argument the kernel hands
    # the entry its DIR, and a dir is not a port
    daemon_file
    set -- "$DIR" ${SLOPP_LIVE:+--live} --main slopp.daemon/-main "${1:-$PORT}"
    ;;
  --call)
    TOOL="${2:-}"; RAW="${3-}"; [ -z "$RAW" ] && RAW="{}"
    ARGSFILE="$(mktemp)"
    if [ "${RAW#@}" != "$RAW" ]; then cat "${RAW#@}" > "$ARGSFILE"; else printf '%s' "$RAW" > "$ARGSFILE"; fi
    ;;
  add|replace|change)
    # The heredoc carries RAW source — no JSON escaping, which is the
    # point. The daemon splits it into steps (`;;;tests <ns>` / `;;;impl
    # <ns>` sections for change; one step for add/replace); this side
    # only frames it: header lines, a blank line, then the blob.
    VERB="$1"; shift
    PROMPT=""; ACCEPT=""; TARGET=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --prompt) PROMPT="${2-}"; shift 2 ;;
        --accept) ACCEPT="${2-}"; shift 2 ;;
        *) TARGET="$1"; shift ;;
      esac
    done
    if [ "$VERB" != "change" ] && [ -z "$TARGET" ]; then
      echo "slopp $VERB: name the target namespace (slopp $VERB <ns>[/<name>] <<EOF)" >&2; exit 2
    fi
    TOOL="$VERB"; ARGSFILE="$(mktemp)"
    {
      printf 'verb: %s\n' "$VERB"
      [ -n "$TARGET" ] && printf 'target: %s\n' "$TARGET"
      [ -n "$PROMPT" ] && printf 'prompt: %s\n' "$PROMPT"
      [ -n "$ACCEPT" ] && printf 'accept: %s\n' "$ACCEPT"
      printf '\n'
      cat
    } > "$ARGSFILE"
    FRAMED=1
    ;;
  -*|"") : ;;
  *)
    # bare-verb spelling: `slopp <op> [json]` — any lowercase_word that is
    # not a directory is a tool call (a typo answers with the tool list)
    if [ ! -d "${1:-}" ] && printf '%s' "${1:-}" | grep -qE '^[a-z][a-z_]*$'; then
      TOOL="$1"; RAW="${2-}"; [ -z "$RAW" ] && RAW="{}"
      ARGSFILE="$(mktemp)"
      if [ "${RAW#@}" != "$RAW" ]; then cat "${RAW#@}" > "$ARGSFILE"; else printf '%s' "$RAW" > "$ARGSFILE"; fi
    fi
    ;;
esac

# ---- route the call to the running daemon ----
# There is no other way to run a tool call: the one-shot JVM that used to
# open the store here stranded its writes on a thread nothing landed, and
# the kernel refuses --call by name now. A call with no daemon FAILS and
# says so; the daemon is a process the user starts (`slopp daemon`) and
# owns, never one a tool call brings up behind them.
#
# The call is one POST of a TEXT frame — header lines, a blank line, the
# payload (the op's arguments as JSON or EDN, or a verb's raw blob) — so
# the shell never builds JSON; the daemon parses and answers text.
if [ -n "$TOOL" ] && [ -s "$ARGSFILE" ]; then
  daemon_file
  if [ ! -f "$DAEMON_FILE" ] || { read_daemon_file; ! kill -0 "$DPID" 2>/dev/null; } \
     || ! curl -sf -m 2 -o /dev/null "$DURL/status"; then
    echo "slopp: $(no_daemon_sentence)" >&2
    rm -f "$ARGSFILE"; exit 2
  fi
  if [ "${FRAMED:-0}" != "1" ]; then
    FRAME="$(mktemp)"
    { printf 'tool: %s\n\n' "$TOOL"; cat "$ARGSFILE"; } > "$FRAME"
    rm -f "$ARGSFILE"; ARGSFILE="$FRAME"
  fi
  OUT="$(mktemp)"
  # a heartbeat while a long op runs, so a shell knows the call is alive
  ( t0=$(date +%s); while sleep 10; do echo "slopp: $TOOL still running ($(( $(date +%s) - t0 ))s)..." >&2; done ) &
  BEAT=$!
  code="$(curl -sS -m 3600 -o "$OUT" -w '%{http_code}' --data-binary @"$ARGSFILE" \
            -H "Content-Type: text/plain; charset=utf-8" \
            -H "X-Slopp-Dir: $PWD" -H "X-Slopp-Token: $DTOKEN" \
            "$DURL/projects/_/cli" 2>&1)" || { kill "$BEAT" 2>/dev/null; echo "slopp: the daemon refused or dropped the call ($code)" >&2; rm -f "$ARGSFILE" "$OUT"; exit 2; }
  kill "$BEAT" 2>/dev/null; wait "$BEAT" 2>/dev/null || true
  cat "$OUT"; echo
  rm -f "$ARGSFILE" "$OUT"
  [ "$code" = "200" ] && exit 0
  exit 1
fi

# A bare <dir> used to serve MCP over stdio on that store, one JVM per
# session. That server is retired: the daemon is the only server, and the
# plugin's entry is a pipe onto it. Say so rather than boot the kernel with
# a project dir as if it were the daemon's own.
if [ -d "${1:-}" ] && ! printf '%s\n' "$@" | grep -qx -- '--main'; then
  echo "slopp: the per-session stdio server is retired — 'slopp daemon' runs the machine's one slopp, and the plugin's server entry is a pipe onto it" >&2
  exit 2
fi

checksum() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

# --doctor: check the whole wiring in one command (Q6) — java, jar cache,
# hook/skill files, curl (the hooks and the CLI need it), and a live store probe.
# Exit 0 = everything an agent session needs is in place.
if [ "${1:-}" = "--doctor" ]; then
  rc=0
  say() { printf '%s %s\n' "$1" "$2"; }
  say "ok " "java: $(java -version 2>&1 | head -1)"
  ROOT="$(cd "$(dirname "$0")/.." && pwd)"
  for f in hooks/hooks.json skills/slopp/SKILL.md skills/slopp-setup/SKILL.md .mcp.json; do
    if [ -f "$ROOT/$f" ]; then say "ok " "plugin file: $f"; else say "FAIL" "plugin file missing: $f"; rc=1; fi
  done
  if command -v curl >/dev/null 2>&1; then say "ok " "curl (the hooks and the CLI talk to the daemon with it)"; else say "FAIL" "no curl — the hooks and 'slopp <op>' cannot reach the daemon"; rc=1; fi
  if [ -n "${SLOPP_JAR:-}" ]; then
    if [ -f "$SLOPP_JAR" ]; then say "ok " "SLOPP_JAR override: $SLOPP_JAR"; else say "FAIL" "SLOPP_JAR set but missing: $SLOPP_JAR"; rc=1; fi
  elif [ -f "$JAR" ]; then
    if [ "$(checksum "$JAR")" = "$SHA256" ]; then say "ok " "jar cached + checksum: $JAR"; else say "FAIL" "cached jar fails checksum: $JAR (delete it; the launcher refetches)"; rc=1; fi
  else
    say "warn" "jar not cached yet — first launch fetches ${VERSION} (~27MB); run 'slopp --warm'"
  fi
  [ -n "${SLOPP_LIVE:-}" ] && say "ok " "SLOPP_LIVE set — server tracks the store live"
  if [ -f ".slopp/store.db" ]; then
    if [ -n "${SLOPP_JAR:-}" ] || [ -f "$JAR" ]; then
      # query_project, not query_namespaces — the latter has never been a
      # tool, so this probe reported FAIL on every healthy install with a
      # store. A self-check that names a tool must name a real one. Routed
      # through the daemon like every call, so it also proves the daemon.
      if out=$("$0" query_project '{}' 2>/dev/null | tail -1); then
        say "ok " "store probe via the daemon: query_project -> ${out:0:60}…"
      else
        say "FAIL" "store at .slopp/store.db but the routed probe call failed — is a daemon running? ('slopp daemon status'; 'slopp daemon' starts one)"; rc=1
      fi
    fi
  else
    say "warn" "no .slopp/store.db in $(pwd) — serving here starts empty (or auto-imports a slopp branch)"
  fi
  exit $rc
fi

# --warm: ensure the jar is cached, run nothing — for an install script or
# an image build that wants the fetch done before the first `slopp daemon`.
WARM=0
if [ "${1:-}" = "--warm" ]; then
  WARM=1
  shift
fi

# The server JVM's memory budget, empty by default. Space-separated, and an
# explicitly empty value means none — so `SLOPP_SERVER_JVM_OPTS=` is the
# off-arm if you are measuring your own.
#
# `-XX:+UseSerialGC -Xms32m` measured 2.62 GB -> 2.17 GB committed on this
# repo's own store (~17%, two independent runs), and cost ~15s on a ~50s
# boot-to-ready (+31%, four paired rounds). That is a REAL trade rather than a
# free win, which is why it is not the default: one agent pays the 15s on
# every session start and never notices the memory, while a box running eight
# writers is the other way round. The images have their own budget
# (SLOPP_IMAGE_JVM_OPTS), measured separately and shipped on, because their
# throughput gate came back clean and this one did not.
SLOPP_SERVER_JVM_OPTS="${SLOPP_SERVER_JVM_OPTS-}"

# Dev override: run a locally built jar (clojure -T:build uber) instead of
# the pinned release — no fetch, no checksum. For testing kernel/jar changes
# exactly as the plugin would run them.
if [ -n "${SLOPP_JAR:-}" ]; then
  [ "$WARM" = "1" ] && exit 0
  exec java $SLOPP_SERVER_JVM_OPTS -jar "$SLOPP_JAR" "$@"
fi

# Single-flight download: the SessionStart warm hook and the MCP server
# launch can both arrive on a cold cache — exactly one fetches (mkdir lock),
# everyone else waits for the jar to appear. A fetcher killed mid-download
# (the MCP client's 30s connect timeout does this) leaves a stale lock and a
# partial file: the next comer takes the lock over and curl RESUMES (-C -),
# so interrupted progress is never wasted. Checksum validates the whole
# file at the end regardless.
if [ ! -f "$JAR" ]; then
  mkdir -p "$CACHE"
  LOCK="$CACHE/fetch-${VERSION}.lock"
  PART="$JAR.part"
  attempts=0
  waiting_said=0
  while [ ! -f "$JAR" ]; do
    if mkdir "$LOCK" 2>/dev/null; then
      echo "$$" >"$LOCK/pid"
      attempts=$((attempts + 1))
      if [ "$attempts" -gt 3 ]; then
        rm -rf "$LOCK"
        echo "slopp: giving up fetching ${VERSION} after 3 attempts" >&2
        exit 1
      fi
      echo "slopp: fetching ${VERSION} from GitHub Releases (one-time, ~27MB)…" >&2
      curl -fsSL --retry 3 --retry-delay 1 -C - -o "$PART" "$JAR_URL" &
      cpid=$!
      echo "$cpid" >"$LOCK/curl"
      trap 'kill "$cpid" 2>/dev/null; rm -rf "$LOCK"' EXIT INT TERM
      if wait "$cpid"; then
        got="$(checksum "$PART")"
        if [ "$got" = "$SHA256" ]; then
          mv "$PART" "$JAR"
        else
          rm -f "$PART"
          echo "slopp: checksum mismatch for ${VERSION} (got $got) — refetching" >&2
        fi
      else
        rm -f "$PART"
        echo "slopp: download failed — retrying" >&2
      fi
      rm -rf "$LOCK"
      trap - EXIT INT TERM
    else
      owner="$(cat "$LOCK/pid" 2>/dev/null || true)"
      if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
        # The fetcher died (e.g. SIGKILLed by the MCP connect timeout). Its
        # curl may have been orphaned and still be writing — take that out
        # too before stealing the lock, or we'd have two writers.
        ocurl="$(cat "$LOCK/curl" 2>/dev/null || true)"
        if [ -n "$ocurl" ]; then
          kill "$ocurl" 2>/dev/null || true
          sleep 1
        fi
        rm -rf "$LOCK"
        continue
      fi
      if [ "$waiting_said" = "0" ]; then
        echo "slopp: waiting for another slopp process to finish fetching ${VERSION}…" >&2
        waiting_said=1
      fi
      sleep 1
    fi
  done
fi

[ "$WARM" = "1" ] && exit 0

exec java $SLOPP_SERVER_JVM_OPTS -jar "$JAR" "$@"
