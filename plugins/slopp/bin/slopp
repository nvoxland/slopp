#!/bin/bash
# slopp CLI — the same release jar the MCP server runs, for direct use:
#   slopp <dir>                                serve MCP on a store (stdio)
#   slopp --call <tool> [json|edn|@file]       one-shot tool call, no session
#   slopp --main slopp.sync/-main import .     build the store from the repo's slopp branch
#   slopp --main slopp.sync/-main test .       isolated suite from a store build
#   slopp --doctor                             self-check the plugin wiring end-to-end
#   slopp daemon [port]                        ONE slopp for the machine: MCP over HTTP for every project
# Fetches and caches the versioned jar on first run; java 21+ required.
set -euo pipefail

VERSION="v0.2.0"
SHA256="23b5274f68e9ead2fd075adbd88cc4abb69fa56d8e5f8fbc0ee166ff4c72ba7c"
JAR_URL="https://github.com/nvoxland/slopp3/releases/download/${VERSION}/slopp.jar"

CACHE="${CLAUDE_PLUGIN_DATA:-${XDG_CACHE_HOME:-$HOME/.cache}/slopp}"
JAR="$CACHE/slopp-${VERSION}.jar"

if ! command -v java >/dev/null 2>&1; then
  echo "slopp: no 'java' on PATH — install a JDK (Temurin 21+ recommended)" >&2
  exit 1
fi

# --help never reaches the JVM: an unrecognized flag used to fall through
# to SERVE MODE, whose listener overwrote a live server's .slopp/ui-port
# with its own transient pid and poisoned the fast path (measured, s13).
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  echo "  slopp <op> '{...json...}'                  bare tool call (routed to the running server)"
  echo "  slopp add <ns> [--prompt P] <<'EOF'        whole-blob write; forms split, add/replace inferred"
  echo "  slopp replace <ns/name> [--prompt P] <<'EOF'"
  echo "  slopp change [--prompt P] [--accept a,b] <<'EOF'   with ;;;tests <ns> / ;;;impl <ns> sections"
  echo "  slopp help '{\"topic\":\"<op>\"}'              one op's full card (args, examples)"
  exit 0
fi

# ---- CLI dialect: normalize every spelling to (TOOL, args-file) ----
#   slopp --call <op> [json|edn|@file]      the long-standing spelling
#   slopp <op> [json]                       same thing, bare
#   slopp add <ns> [--prompt P] <<EOF       whole-blob write: forms split and
#   slopp replace <ns/name> [--prompt P]    add/replace is inferred per form
#   slopp change [--prompt P] [--accept a,b] <<EOF
#       with ";;;tests <ns>" / ";;;impl <ns>" section markers between raw forms
# The heredoc carries RAW source — no JSON escaping, which is the point.
TOOL=""; ARGSFILE=""
case "${1:-}" in
  daemon)
    # The daemon boots slopp's OWN code from the dir it is given — the
    # kernel loads every namespace of that dir's store into the JVM — so it
    # is launched from a NEUTRAL dir (~/.slopp, no store), never a project:
    # the projects it serves are whatever attaches. SLOPP_LIVE=1 from a
    # checkout of slopp itself is the self-host loop (SLOPP_DAEMON_DIR=$PWD
    # --live), the same knob slopp-server honours.
    DIR="${SLOPP_DAEMON_DIR:-$HOME/.slopp}"
    mkdir -p "$DIR"
    shift
    set -- "$DIR" ${SLOPP_LIVE:+--live} --main slopp.daemon/-main "$@"
    ;;
  --call)
    TOOL="${2:-}"; RAW="${3-}"; [ -z "$RAW" ] && RAW="{}"
    ARGSFILE="$(mktemp)"
    if [ "${RAW#@}" != "$RAW" ]; then cat "${RAW#@}" > "$ARGSFILE"; else printf '%s' "$RAW" > "$ARGSFILE"; fi
    ;;
  add|replace|change)
    ARGSFILE="$(mktemp)"; PROG="$(mktemp)"
    cat > "$PROG" <<'PYEOF'
import json, sys
argsfile = sys.argv[1]
argv = sys.argv[2:]
verb = argv[0]; rest = list(argv[1:])
def flag(name, default=None):
    if name in rest:
        i = rest.index(name); v = rest[i+1]; del rest[i:i+2]; return v
    return default
prompt = flag("--prompt")
accept = flag("--accept")
body = sys.stdin.read()
if verb in ("add", "replace"):
    target = rest[0] if rest else ""
    if not target:
        print(f"slopp {verb}: name the target namespace (slopp {verb} <ns>[/<name>] <<EOF)", file=sys.stderr)
        sys.exit(2)
    ns, _, nm = target.partition("/")
    step = {"ns": ns, "source": body}
    if nm: step["name"] = nm
    args = {"prompt": prompt or f"slopp {verb} {target}", "impl": [step]}
else:
    args = {"prompt": prompt or "slopp change", "tests": [], "impl": []}
    if accept: args["accept"] = [a for a in accept.split(",") if a]
    section, ns, buf = None, None, []
    def close():
        if section and ns and "".join(buf).strip():
            args[section].append({"ns": ns, "source": "".join(buf)})
    for line in body.splitlines(keepends=True):
        w = line.split()
        if len(w) == 2 and w[0] in (";;;tests", ";;;impl"):
            close(); section, ns, buf = w[0][3:], w[1], []
        else:
            buf.append(line)
    close()
    if not (args["tests"] or args["impl"]):
        print("slopp change: stdin needs ';;;tests <ns>' / ';;;impl <ns>' section markers", file=sys.stderr)
        sys.exit(2)
    if not args["tests"]: del args["tests"]
json.dump(args, open(argsfile, "w"))
print("change")
PYEOF
    TOOL="$(python3 "$PROG" "$ARGSFILE" "$@")" || { rm -f "$PROG" "$ARGSFILE"; exit 2; }
    rm -f "$PROG"
    ;;
  -*|"") : ;;
  *)
    # bare-verb spelling: `slopp <op> [json]` — any lowercase_word that is
    # not a directory is a tool call (a typo answers with the tool list)
    if [ ! -d "${1:-}" ] && printf '%s' "${1:-}" | grep -qE '^[a-z][a-z_]*$'; then
      TOOL="$1"; RAW="${2-}"; [ -z "$RAW" ] && RAW="{}"
      ARGSFILE="$(mktemp)"
      if [ "${RAW#@}" != "$RAW" ]; then cat "${RAW#@}" > "$ARGSFILE"; else printf '%s' "$RAW" > "$ARGSFILE"; fi
    fi
    ;;
esac

# ---- route the normalized call to the RUNNING server, else the JVM ----
if [ -n "$TOOL" ] && [ -s "$ARGSFILE" ]; then
  if [ -z "${SLOPP_NO_ROUTE:-}" ] && [ -f ".slopp/ui-port" ]; then
    set +e
    python3 - "$TOOL" "$ARGSFILE" <<'PYEOF'
import json, os, sys, time, threading, urllib.request
tool, argsfile = sys.argv[1], sys.argv[2]
try:
    pf = json.load(open(".slopp/ui-port"))
    pid, url, token = pf["pid"], pf["url"], pf.get("token")
    os.kill(int(pid), 0)
    if not token:
        raise RuntimeError("listener predates the routed door (no token)")
    args = json.load(open(argsfile))
    if not isinstance(args, dict):
        raise RuntimeError("arguments must be a JSON object")
except Exception as e:
    print(f"slopp: fast path unavailable ({e})", file=sys.stderr)
    sys.exit(3)
body = json.dumps({"tool": tool, "arguments": args, "token": token}).encode()
stop = threading.Event()
def beat():
    t0 = time.time()
    while not stop.wait(10):
        print(f"slopp: {tool} still running ({int(time.time()-t0)}s)...", file=sys.stderr)
threading.Thread(target=beat, daemon=True).start()
req = urllib.request.Request(url.rstrip("/") + "/api/call", data=body,
                             headers={"Content-Type": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=3600) as r:
        out = json.load(r)
except Exception as e:
    stop.set()
    print(f"slopp: fast path failed ({e})", file=sys.stderr)
    sys.exit(3)
stop.set()
print(out.get("text", ""))
sys.exit(1 if out.get("isError") else 0)
PYEOF
    rc=$?
    set -e
    if [ "$rc" -ne 3 ]; then rm -f "$ARGSFILE"; exit "$rc"; fi
    echo "slopp: falling back to the one-shot JVM (slower; no progress until it answers)" >&2
  fi
  set -- --call "$TOOL" "@$ARGSFILE"
fi

checksum() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

# --doctor: check the whole wiring in one command (Q6) — java, jar cache,
# hook/skill files, python3 (the hooks need it), and a live store probe.
# Exit 0 = everything an agent session needs is in place.
if [ "${1:-}" = "--doctor" ]; then
  rc=0
  say() { printf '%s %s\n' "$1" "$2"; }
  say "ok " "java: $(java -version 2>&1 | head -1)"
  ROOT="$(cd "$(dirname "$0")/.." && pwd)"
  for f in hooks/hooks.json skills/slopp/SKILL.md skills/slopp-setup/SKILL.md .mcp.json; do
    if [ -f "$ROOT/$f" ]; then say "ok " "plugin file: $f"; else say "FAIL" "plugin file missing: $f"; rc=1; fi
  done
  if command -v python3 >/dev/null 2>&1; then say "ok " "python3 (prompt/done hooks)"; else say "FAIL" "no python3 — the intent + done hooks will not fire"; rc=1; fi
  if [ -n "${SLOPP_JAR:-}" ]; then
    if [ -f "$SLOPP_JAR" ]; then say "ok " "SLOPP_JAR override: $SLOPP_JAR"; else say "FAIL" "SLOPP_JAR set but missing: $SLOPP_JAR"; rc=1; fi
  elif [ -f "$JAR" ]; then
    if [ "$(checksum "$JAR")" = "$SHA256" ]; then say "ok " "jar cached + checksum: $JAR"; else say "FAIL" "cached jar fails checksum: $JAR (delete it; the launcher refetches)"; rc=1; fi
  else
    say "warn" "jar not cached yet — first launch fetches ${VERSION} (~27MB); run 'slopp --warm'"
  fi
  [ -n "${SLOPP_LIVE:-}" ] && say "ok " "SLOPP_LIVE set — server tracks the store live"
  if [ -f ".slopp/store.db" ]; then
    if [ -n "${SLOPP_JAR:-}" ] || [ -f "$JAR" ]; then
      probe_jar="${SLOPP_JAR:-$JAR}"
      # query_project, not query_namespaces — the latter has never been a
      # tool, so this probe reported FAIL on every healthy install with a
      # store. A self-check that names a tool must name a real one.
      if out=$(java -jar "$probe_jar" --call query_project 2>/dev/null | tail -1); then
        say "ok " "store probe: query_project -> ${out:0:60}…"
      else
        say "FAIL" "store at .slopp/store.db but the probe call failed"; rc=1
      fi
    fi
  else
    say "warn" "no .slopp/store.db in $(pwd) — serving here starts empty (or auto-imports a slopp branch)"
  fi
  exit $rc
fi

# --warm: ensure the jar is cached, run nothing (the SessionStart hook uses
# this so the one-time download never races the MCP connection timeout).
WARM=0
if [ "${1:-}" = "--warm" ]; then
  WARM=1
  shift
fi

# The server JVM's memory budget, empty by default. Space-separated, and an
# explicitly empty value means none — so `SLOPP_SERVER_JVM_OPTS=` is the
# off-arm if you are measuring your own.
#
# `-XX:+UseSerialGC -Xms32m` measured 2.62 GB -> 2.17 GB committed on this
# repo's own store (~17%, two independent runs), and cost ~15s on a ~50s
# boot-to-ready (+31%, four paired rounds). That is a REAL trade rather than a
# free win, which is why it is not the default: one agent pays the 15s on
# every session start and never notices the memory, while a box running eight
# writers is the other way round. The images have their own budget
# (SLOPP_IMAGE_JVM_OPTS), measured separately and shipped on, because their
# throughput gate came back clean and this one did not.
SLOPP_SERVER_JVM_OPTS="${SLOPP_SERVER_JVM_OPTS-}"

# Dev override: run a locally built jar (clojure -T:build uber) instead of
# the pinned release — no fetch, no checksum. For testing kernel/jar changes
# exactly as the plugin would run them.
if [ -n "${SLOPP_JAR:-}" ]; then
  [ "$WARM" = "1" ] && exit 0
  exec java $SLOPP_SERVER_JVM_OPTS -jar "$SLOPP_JAR" "$@"
fi

# Single-flight download: the SessionStart warm hook and the MCP server
# launch can both arrive on a cold cache — exactly one fetches (mkdir lock),
# everyone else waits for the jar to appear. A fetcher killed mid-download
# (the MCP client's 30s connect timeout does this) leaves a stale lock and a
# partial file: the next comer takes the lock over and curl RESUMES (-C -),
# so interrupted progress is never wasted. Checksum validates the whole
# file at the end regardless.
if [ ! -f "$JAR" ]; then
  mkdir -p "$CACHE"
  LOCK="$CACHE/fetch-${VERSION}.lock"
  PART="$JAR.part"
  attempts=0
  waiting_said=0
  while [ ! -f "$JAR" ]; do
    if mkdir "$LOCK" 2>/dev/null; then
      echo "$$" >"$LOCK/pid"
      attempts=$((attempts + 1))
      if [ "$attempts" -gt 3 ]; then
        rm -rf "$LOCK"
        echo "slopp: giving up fetching ${VERSION} after 3 attempts" >&2
        exit 1
      fi
      echo "slopp: fetching ${VERSION} from GitHub Releases (one-time, ~27MB)…" >&2
      curl -fsSL --retry 3 --retry-delay 1 -C - -o "$PART" "$JAR_URL" &
      cpid=$!
      echo "$cpid" >"$LOCK/curl"
      trap 'kill "$cpid" 2>/dev/null; rm -rf "$LOCK"' EXIT INT TERM
      if wait "$cpid"; then
        got="$(checksum "$PART")"
        if [ "$got" = "$SHA256" ]; then
          mv "$PART" "$JAR"
        else
          rm -f "$PART"
          echo "slopp: checksum mismatch for ${VERSION} (got $got) — refetching" >&2
        fi
      else
        rm -f "$PART"
        echo "slopp: download failed — retrying" >&2
      fi
      rm -rf "$LOCK"
      trap - EXIT INT TERM
    else
      owner="$(cat "$LOCK/pid" 2>/dev/null || true)"
      if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
        # The fetcher died (e.g. SIGKILLed by the MCP connect timeout). Its
        # curl may have been orphaned and still be writing — take that out
        # too before stealing the lock, or we'd have two writers.
        ocurl="$(cat "$LOCK/curl" 2>/dev/null || true)"
        if [ -n "$ocurl" ]; then
          kill "$ocurl" 2>/dev/null || true
          sleep 1
        fi
        rm -rf "$LOCK"
        continue
      fi
      if [ "$waiting_said" = "0" ]; then
        echo "slopp: waiting for another slopp process to finish fetching ${VERSION}…" >&2
        waiting_said=1
      fi
      sleep 1
    fi
  done
fi

[ "$WARM" = "1" ] && exit 0

exec java $SLOPP_SERVER_JVM_OPTS -jar "$JAR" "$@"
