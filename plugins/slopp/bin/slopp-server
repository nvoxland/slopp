#!/bin/bash
# slopp MCP server launcher (the plugin's .mcp.json entry point).
#
# The plugin repo carries only this recipe; the server itself is the release
# uberjar, fetched once by bin/slopp and cached under the plugin's persistent
# data dir. Bumping VERSION+SHA256 in bin/slopp (with the plugin version) is
# the whole upgrade story. Prerequisite: java 21+ on PATH.
#
# The store dir: explicit arg > Claude's project dir > cwd (stdio MCP servers
# are launched in the project dir). A dir with no store gets an empty one.
set -euo pipefail

DIR="${1:-${CLAUDE_PROJECT_DIR:-$PWD}}"

# Dev knob: SLOPP_LIVE=1 adds --live, hot-reloading the server's own
# namespaces as the store changes — the self-host loop (set it in the repo's
# .claude/settings.json env). Default stays snapshot: a fresh session always
# boots the current store anyway.
# THE DAEMON is the default: this entry is a PIPE onto the machine's one
# slopp (bin/slopp-pipe.py) — the same stdio contract from Claude Code's
# side, MCP over HTTP from the daemon's, one process for every project on
# the box, started on demand. SLOPP_DAEMON=0 keeps a JVM per session (the
# self-contained fallback, and the baseline the evals were measured
# against). Flipped 2026-09-07 after the memory census, the two-session
# check and the whole external suite ran green against the daemon.
if [ "${SLOPP_DAEMON:-1}" != "0" ]; then
  cd "$DIR"
  exec python3 "$(cd "$(dirname "$0")" && pwd)/slopp-pipe.py"
fi

ARGS=("$DIR")
if [ "${SLOPP_LIVE:-}" = "1" ]; then
  ARGS+=("--live")
fi
exec "$(cd "$(dirname "$0")" && pwd)/slopp" "${ARGS[@]}"
